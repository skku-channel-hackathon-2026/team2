{
  "name": "channel-app-tutorial-typescript",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.22.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "data:caption-wiki": "node data/script/caption-sopmu-images.mjs",
    "data:collect": "node data/script/collect-skku.mjs",
    "data:instagram": "node data/script/collect-instagram.mjs",
    "data:prepare-wiki": "node data/script/prepare-sopmu-wiki.mjs",
    "data:everytime": "node data/everytime/tool.mjs",
    "knowledge:plan": "node --env-file-if-exists=.env.documents.local scripts/sync-channel-documents.mjs",
    "knowledge:publish": "node --env-file-if-exists=.env.documents.local scripts/sync-channel-documents.mjs --publish",
    "test": "pnpm --filter @tutorial/shared build && pnpm --filter @tutorial/server test",
    "typecheck": "pnpm --filter @tutorial/shared build && pnpm -r typecheck",
    "lint": "pnpm --filter @tutorial/wam lint",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore",
    "dev:server": "pnpm --filter @tutorial/shared build && pnpm --filter @tutorial/server dev",
    "dev:wam": "pnpm --filter @tutorial/shared build && pnpm --filter @tutorial/wam dev",
    "start": "pnpm --filter @tutorial/server start",
    "build:vercel": "pnpm build && node scripts/build-vercel.mjs",
    "register": "pnpm --filter @tutorial/server register",
    "test:vercel": "node scripts/smoke-vercel.mjs",
    "build:cloudflare": "pnpm build && node scripts/build-cloudflare.mjs",
    "dev:cloudflare": "wrangler dev --local",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "test:cloudflare": "node scripts/smoke-cloudflare.mjs"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "wrangler": "^4.132.0"
  }
}
