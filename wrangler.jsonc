{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "c9ef2a6dff92572bec4ffcab751820fc",
  "name": "skku-team2",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "cloudflare/static",
    "binding": "ASSETS",
    "run_worker_first": ["/functions", "/functions/*", "/api/*"],
  },
  "vars": {
    "AUTO_REGISTER": "false",
    "CLOUDFLARE_WORKER": "1",
    // Temporary: enables POST /api/register so the Worker can refresh its own
    // extension registration. Remove this var once commands are registered.
    "REGISTER_TOKEN": "4bDpKwhXs_-EzsUwv6GqvLU8huC0dT1W",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "skku-team2",
      "database_id": "d6d86b00-5cd8-4778-806c-b635b7c043b7",
      "migrations_dir": "cloudflare/migrations",
    },
  ],
  "alias": {
    "@nestjs/websockets/socket-module": "./cloudflare/unsupported-optional.cjs",
    "@nestjs/microservices/microservices-module": "./cloudflare/unsupported-optional.cjs",
    "@nestjs/microservices": "./cloudflare/unsupported-optional.cjs",
    "class-validator": "./cloudflare/unsupported-optional.cjs",
    "class-transformer": "./cloudflare/unsupported-optional.cjs",
  },
}
